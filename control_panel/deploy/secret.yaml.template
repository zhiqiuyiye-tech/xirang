# Secret template - PLACEHOLDER VALUES ONLY.
#
# This file is committed with dummy base64 values. The REAL secret.yaml is
# generated by install.sh (which generates fresh AES_KEY/JWT_SECRET via
# openssl and prompts for ADMIN_INIT_PASSWORD). The generated secret.yaml is
# git-ignored (see .gitignore in this directory).
#
# DO NOT use these placeholder values in production. Run install.sh.
#
# The three keys below are the env vars required by the control panel backend
# (see internal/config/config.go):
#   - AES_KEY: 32 random bytes, base64-encoded (openssl rand 32 | base64)
#   - JWT_SECRET: random bytes, base64-encoded (openssl rand 32 | base64)
#   - ADMIN_INIT_PASSWORD: initial admin password, base64-encoded
#
# Note: per-worker SSH private keys are NOT mounted as a file. They are uploaded
# via the web UI (SetPrivateKey API) and stored AES-encrypted in SQLite. See
# README.md for details.

apiVersion: v1
kind: Secret
metadata:
  name: control-panel-secrets
  namespace: control-panel
  labels:
    app.kubernetes.io/name: control-panel
type: Opaque
data:
  # Placeholder - REPLACE via install.sh
  AES_KEY: UkVQTEFDRV9XSVRIX0lUX1BMQUNFSE9MREVSX0ZPT1BBQTIyMjIyMjI=
  # Placeholder - REPLACE via install.sh
  JWT_SECRET: UkVQTEFDRV9XSVRIX0lUQ19QTEFDRUhPTERFUl9GT09QQUFfSk9CNDQ0NDQ=
  # Placeholder - REPLACE via install.sh (echo -n 'yourpass' | base64)
  ADMIN_INIT_PASSWORD: UkVQTEFDRV9XSVRIX1BBU1NXT1JEX0hFUkU=
